# MongoDB used by the Compose backend
MONGODB_URI=mongodb://mongodb:27017/mern-todo

# Public frontend origin (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:8080

# Monitoring and local container ports
REDIS_PORT=6379
REDIS_PASSWORD=
API_PORT=5000
CLIENT_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password
