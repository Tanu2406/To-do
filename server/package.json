{
  "name": "mern-todo-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:local": "cross-env NODE_ENV=development nodemon index.js",
    "test": "jest --coverage --runInBand"
  },
  "author": "Chetan Nada",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "mongoose": "^8.24.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "controllers/**/*.js",
      "models/**/*.js",
      "routes/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
